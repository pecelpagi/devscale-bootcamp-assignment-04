# OpenAI-compatible API used by the agent and model-graded evaluations.
OPENAI_API_KEY=replace-with-your-api-key
# Optional; uncomment and set for a compatible gateway.
# OPENAI_BASE_URL=https://your-gateway.example/v1

# Anvia Lens instance that receives evaluation results.
# For the bundled local Docker Compose stack, use http://localhost.
ANVIA_LENS_BASE_URL=http://localhost
ANVIA_LENS_PUBLIC_KEY=replace-with-your-public-key
ANVIA_LENS_SECRET_KEY=replace-with-your-secret-key
